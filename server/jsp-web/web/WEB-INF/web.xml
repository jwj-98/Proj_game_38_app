<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <servlet>
        <servlet-name>signup-jsp</servlet-name>
        <jsp-file>/signup.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>createnick-jsp</servlet-name>
        <jsp-file>/createnick.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>signin-jsp</servlet-name>
        <jsp-file>/signin.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>getuserinfo-jsp</servlet-name>
        <jsp-file>/getuserinfo.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>findAccount-jsp</servlet-name>
        <jsp-file>/findAccount.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>testmail-jsp</servlet-name>
        <jsp-file>/testmail.jsp</jsp-file>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>signup-jsp</servlet-name>
        <url-pattern>/signup</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>createnick-jsp</servlet-name>
        <url-pattern>/createnick</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>signin-jsp</servlet-name>
        <url-pattern>/signin</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>getuserinfo-jsp</servlet-name>
        <url-pattern>/getuserinfo</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>findAccount-jsp</servlet-name>
        <url-pattern>/findAccount</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>testmail-jsp</servlet-name>
        <url-pattern>/testmail</url-pattern>
    </servlet-mapping>

    
</web-app>